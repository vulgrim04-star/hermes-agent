# Projet Supabase — Project Settings → API dans le tableau de bord Supabase.
# Ces deux valeurs sont publiques par nature : la clé « anon » ne donne accès
# qu'à ce que les policies RLS autorisent, c'est-à-dire les lignes du compte
# connecté. Ne jamais mettre ici la clé « service_role », qui contourne la RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
