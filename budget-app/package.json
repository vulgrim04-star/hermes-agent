{
  "name": "budget-menage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gestion du budget d'un ménage suisse — application locale, données jamais transmises hors de la machine.",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b tsconfig.app.json tsconfig.server.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.62.0",
    "better-sqlite3": "^12.0.0",
    "exceljs": "^4.4.0",
    "hono": "^4.6.0",
    "papaparse": "^5.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.17.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.20.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
